{
  "expo": {
    "name": "Pendum Body",
    "slug": "vector-body",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bodytrack",
    "userInterfaceStyle": "automatic",
    "primaryColor": "#007088",
    "ios": {
      "icon": {
        "light": "./assets/images/icon.png",
        "dark": "./assets/images/icon-dark.png",
        "tinted": "./assets/images/icon-tinted.png"
      },
      "supportsTablet": false,
      "bundleIdentifier": "dev.svindland.vector.body",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-icon-monochrome.png",
        "backgroundColor": "#22d3ee"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_WEIGHT",
        "android.permission.health.WRITE_WEIGHT",
        "android.permission.health.READ_HEIGHT",
        "android.permission.health.WRITE_HEIGHT",
        "android.permission.health.WRITE_BODY_FAT",
        "android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND"
      ],
      "package": "dev.svindland.vector.body"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#22d3ee",
          "dark": {
            "image": "./assets/images/splash-icon-dark.png",
            "backgroundColor": "#071017"
          }
        }
      ],
      "expo-status-bar",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose progress photos to save privately in Pendum Body.",
          "cameraPermission": "Take progress photos to save privately in Pendum Body.",
          "microphonePermission": false
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": [
            "en",
            "es",
            "fr",
            "de",
            "it",
            "pt",
            "nl",
            "sv",
            "ja",
            "ko",
            "zh-Hans"
          ]
        }
      ],
      [
        "@kingstinct/react-native-healthkit",
        {
          "background": false,
          "NSHealthShareUsageDescription": "Import your weight and height into Pendum Body when you choose to sync.",
          "NSHealthUpdateUsageDescription": "Save your Pendum Body weight, height, waist circumference and recorded body fat to Apple Health when you choose to sync."
        }
      ],
      "react-native-health-connect",
      "./plugins/with-health-rationale",
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-background-task",
      [
        "./plugins/with-vector-vault",
        {
          "app": "body",
          "icloud": false,
          "google": {
            "iosClientId": null,
            "android": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f81cc066-e20b-4ef3-ba94-273f069fc935"
      }
    }
  }
}
